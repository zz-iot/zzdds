// integration-tests/ignore-entities -- shared type. Deliberately minimal (a
// bare sequence number), unkeyed, single instance -- the point of this
// scenario is ignore_participant/ignore_topic/ignore_publication/
// ignore_subscription's discovery-gating semantics, not the payload. Copied
// verbatim into each language's own idl/ dir, matching every other
// integration-tests scenario's convention. See
// docs/design/integration-test-tier.md.
@appendable
struct IgnoreEvent {
    int32 seq;
};
