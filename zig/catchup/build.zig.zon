.{
    .name = .zzdds_examples_catchup_zig,
    .version = "0.0.0",
    .fingerprint = 0x4006c4e87a47a5ea,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // TEMPORARY, not the final state: points at the zzdds-liveliness fix
        // worktree, not the normal sibling zzdds -- not because catchup
        // needs LIVELINESS fixes (it doesn't touch that QoS at all), but
        // because that worktree's own build.zig.zon happens to already be
        // pointed at the zidl fix worktree (branch
        // fix/getfieldfromcdr-unused-params) this example genuinely does
        // need: HistoryEvent has no string-typed member, which hits the
        // exact same generated-getFieldFromCdr unused-parameter bug
        // zig/presence found. Revert this back to the plain sibling path
        // once that zidl fix is released and zzdds's own pin moves past it
        // -- same "dormant until the pin moves" pattern as zig/presence's
        // own build.zig.zon.
        // .zzdds = .{
        //     .path = "../../../zzdds",
        // },
        .zzdds = .{
            .path = "../../../zzdds-liveliness-notify-on-alive",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "publisher.zig",
        "subscriber.zig",
        "idl",
    },
}
