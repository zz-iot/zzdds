+
+test "SPDP explicit domain ID is independent of receiver domain and byte order" {
+    const prefix = guid(0x7A, 0).prefix;
+    const little = [_]u8{ 0, 3, 0, 0, 0x0f, 0, 4, 0, 42, 0, 0, 0, 1, 0, 0, 0 };
+    const big = [_]u8{ 0, 2, 0, 0, 0, 0x0f, 0, 4, 0, 0, 0, 42, 0, 1, 0, 0 };
+    for ([_][]const u8{ &little, &big }) |payload| {
+        var kp = try spdp.decodeSpdpParticipant(alloc, prefix, 7, payload, .{ .bytes = .{ 0, 0 } });
+        defer kp.deinit();
+        try testing.expectEqual(@as(u32, 42), kp.data.domain_id);
+    }
+    const absent = [_]u8{ 0, 3, 0, 0, 1, 0, 0, 0 };
+    var kp = try spdp.decodeSpdpParticipant(alloc, prefix, 7, &absent, .{ .bytes = .{ 0, 0 } });
+    defer kp.deinit();
+    try testing.expectEqual(@as(u32, 7), kp.data.domain_id);
+}
